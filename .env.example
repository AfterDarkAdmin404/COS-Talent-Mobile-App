# Copy this file to `.env` and fill in your Supabase project's values.
# Find both at: Supabase Dashboard -> Project Settings -> API.
#
# SUPABASE_URL is the "Project URL" (https://<project-ref>.supabase.co).
# SUPABASE_ANON_KEY is the "anon" / "public" key — safe to ship in a mobile
# app (it's rate-limited and constrained by Row Level Security), unlike the
# service_role key, which must never appear in client code.

SUPABASE_URL=
SUPABASE_ANON_KEY=
